# Memory Palace - 环境变量配置示例
# 复制此文件为 .env 并填入真实值

# ===================
# 必填 API Keys
# ===================

# MiniMax Chat API (LLM 调用)
MINIMAX_API_KEY="your_minimax_api_key_here"

# DashScope API (向量 Embedding)
DASHSCOPE_API_KEY="your_dashscope_api_key_here"

# ===================
# 可选 API Keys
# ===================

# Readwise Token (同步高亮)
READWISE_TOKEN="your_readwise_token_here"
