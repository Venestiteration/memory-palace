# Memory Palace - 环境变量配置示例
# 复制此文件为 .env 并填入真实值

# ===================
# 必填 API Keys
# ===================

# MiniMax Chat API (LLM 调用)
MINIMAX_API_KEY="your_minimax_api_key_here"

# DashScope API (向量 Embedding)
DASHSCOPE_API_KEY="your_dashscope_api_key_here"

# ===================
# 可选 API Keys
# ===================

# Readwise Token (同步高亮)
READWISE_TOKEN="your_readwise_token_here"

# Telegram Bot (启用 Telegram 捕获时需要)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# Local API protection (未配置时为开发模式匿名访问)
MEMORY_PALACE_API_TOKEN="replace_with_a_long_random_token"
